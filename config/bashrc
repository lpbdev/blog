# ============================================================
# ~/.bashrc  —  interactive shells only
# ============================================================

# If not running interactively, don't do anything
case $- in
    *i*) ;;
      *) return;;
esac

# ------------------------------------------------------------
# History
# ------------------------------------------------------------
HISTCONTROL=ignoreboth:ignoredups:erasedups
HISTIGNORE='history:cd:exit:ls:pwd:man'
HISTSIZE=1000000
HISTFILESIZE=2000000
shopt -s histappend
shopt -s checkwinsize

# ------------------------------------------------------------
# debian chroot
# ------------------------------------------------------------
if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
    debian_chroot=$(cat /etc/debian_chroot)
fi

# ------------------------------------------------------------
# Colors: ls / grep
# ------------------------------------------------------------
if [ -x /usr/bin/dircolors ]; then
    test -r ~/.dircolors && eval "$(dircolors -b ~/.dircolors)" \
                         || eval "$(dircolors -b)"
    alias ls='ls --color=auto'
    alias dir='dir --color=auto'
    alias vdir='vdir --color=auto'
    alias grep='grep -n --color=auto'
    alias fgrep='fgrep --color=auto'
    alias egrep='egrep --color=auto'
fi

# ------------------------------------------------------------
# Enable color prompt
# ------------------------------------------------------------
force_color_prompt=yes
if [ -n "$force_color_prompt" ]; then
    if [ -x /usr/bin/tput ] && tput setaf 1 >&/dev/null; then
        color_prompt=yes
    else
        color_prompt=
    fi
fi
unset force_color_prompt

# ------------------------------------------------------------
# Prompt
# ------------------------------------------------------------
git_branch() {
    local ref branch
    ref=$(git symbolic-ref --short HEAD 2>/dev/null) || return
    branch="$ref"
    if git diff --quiet 2>/dev/null \
       && git diff --cached --quiet 2>/dev/null \
       && [ -z "$(git ls-files --others --exclude-standard)" ]; then
        printf '[%s]' "$branch"
    else
        printf '*%s*' "$branch"
    fi
}

# 只在交互式 + 有 git 时挂 git_branch
if command -v git >/dev/null 2>&1; then
    PS1='${debian_chroot:+($debian_chroot)}'
    PS1+='\[\033[1;32m\][\u@\h]\[\e[0m\]'
    PS1+='\[\033[1;35m\][\w]\[\e[0m\]'
    PS1+='\[\033[1;33m\]$(git_branch)\[\e[0m\]'
    PS1+='\[\033[1;32m\]$ \[\e[0m\]'
else
    PS1='${debian_chroot:+($debian_chroot)}'
    PS1+='\[\033[1;32m\][\u@\h]\[\e[0m\]'
    PS1+='\[\033[1;35m\][\w]\[\e[0m\]'
    PS1+='\[\033[1;32m\]$ \[\e[0m\]'
fi

# Set xterm title
case "$TERM" in
    xterm*|rxvt*)
        PS1="\[\e]0;\u@\h: \w\a\]$PS1"
        ;;
esac

# ------------------------------------------------------------
# PATH (merge duplicates, single export at the end)
# ------------------------------------------------------------
PATH="/opt/bin:$HOME/.local/bin:$HOME/bins/bin:/usr/local/lib:$PATH"
export PATH

# Ruby gems
export GEM_HOME="$HOME/.gems"
PATH="$GEM_HOME/bin:$PATH"
export PATH

# ------------------------------------------------------------
# Aliases — simple
# ------------------------------------------------------------
alias his='history'
alias vi='vim'
alias q='exit'
alias c='clear'
alias ls='ls -h --color --time-style=+%Y/%m/%d\ %H:%M:%S'
alias du='du --max-depth=1'

# ------------------------------------------------------------
# Aliases — git
# ------------------------------------------------------------
alias commit='git commit -a -m'
alias push='git push origin master'

# ------------------------------------------------------------
# Aliases — apt / pip
# ------------------------------------------------------------
alias up='sudo apt-get update && sudo apt-get dist-upgrade && sudo apt-get autoremove'
alias pip3up="pip3 freeze --local | grep -v '^\-e' | cut -d = -f 1 | xargs pip3 install -U"

# ------------------------------------------------------------
# Aliases — file tools
# ------------------------------------------------------------
alias cpr='rsync -rltgoDh --info=progress2'
alias rsmv='rsync -a --info=progress2 --remove-source-files'
alias cgrep='grep -Rn --color'
alias dos2unixall='find . -type f -exec dos2unix {} \;'
alias unix2dosall='find . -type f -exec unix2dos {} \;'
alias unzipall='parallel unzip ::: *.zip'

# ------------------------------------------------------------
# Aliases — system info
# ------------------------------------------------------------
alias topsize='find . -type f -exec du -h {} + | sort -rh | head -10'
alias topcpus='ps aux --sort=-%cpu | head -11'
alias topmems='ps aux --sort=-%mem | head -11'

# ------------------------------------------------------------
# Aliases — pandoc
# ------------------------------------------------------------
_pandoc_base="-s --pdf-engine=xelatex --highlight-style=tango --dpi=300 \
-V CJKmainfont='WenQuanYi Micro Hei' -V fontsize=11pt \
-V documentclass=scrreprt"

alias md2a4report="pandoc $_pandoc_base -V papersize=a4"
alias md2b5report="pandoc $_pandoc_base -V papersize=b5"
alias md2a5report="pandoc $_pandoc_base -V papersize=a5"

# ------------------------------------------------------------
# Aliases — ftp
# ------------------------------------------------------------
_ftp_opts="set ftp:ssl-allow yes"
_ftp_opts_strict="set ftp:ssl-allow yes;set ssl:verify-certificate no"

alias ftpEpn="lftp -u anonymous,passwd -e \"$_ftp_opts\"        ftp.epncb.oma.be:/pub/data/format/"
alias ftpEsa="lftp -u anonymous,passwd -e \"$_ftp_opts\"        gssc.esa.int"
alias ftpHkc="lftp -u anonymous,passwd -e \"$_ftp_opts_strict\" ftp.geodetic.gov.hk"
alias ftpIgn="lftp -u anonymous,passwd -e \"$_ftp_opts\"        igs.ign.fr"
alias ftpUnv="lftp -u anonymous,passwd -e \"$_ftp_opts\"        data-out.unavco.org"
alias ftpWhu="lftp -u anonymous,passwd -e \"$_ftp_opts\"        igs.gnsswhu.cn"
alias ftpBkg="lftp -u anonymous,passwd -e \"$_ftp_opts\"        igs-ftp.bkg.bund.de"
alias ftpAus="lftp -u anonymous,passwd -e \"$_ftp_opts\"        ftp.ga.gov.au"
alias ftpNas="lftp -u anonymous,passwd -e \"set ftp:ssl-force yes\" gdc.cddis.eosdis.nasa.gov"
#
# ------------------------------------------------------------
# Function: say (有道发音)
# ------------------------------------------------------------
function say() {
    mpv "http://dict.youdao.com/dictvoice?audio=${1}&type=1" >/dev/null
}

# ------------------------------------------------------------
# safer rm  — 优先用 trash, 没有就 rm -i
# ------------------------------------------------------------
if command -v trash >/dev/null 2>&1; then
    function rm() { command trash "$@"; }
elif command -v trash-put >/dev/null 2>&1; then
    function rm() { command trash-put "$@"; }
else
    alias rm='rm -i'
fi

# ------------------------------------------------------------
# extra aliases / sourcing
# ------------------------------------------------------------
if [ -f ~/.bash_aliases ]; then
    . ~/.bash_aliases
fi

# bash-completion
if ! shopt -oq posix; then
    if [ -f /usr/share/bash-completion/bash_completion ]; then
        . /usr/share/bash-completion/bash_completion
    elif [ -f /etc/bash_completion ]; then
        . /etc/bash_completion
    fi
fi

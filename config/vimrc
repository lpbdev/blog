source $VIMRUNTIME/defaults.vim
let mapleader=" "
set bg=dark
set path=.,,,**   " 从当前目录向上 2 级（到 ~/project/）再向下递归
set wildmenu 

set mouse=
set lazyredraw          " 延迟重绘（提升性能）
set ttyfast             " 快速终端连接
set showbreak=
set backspace=indent,eol,start  " 更好的退格键行为
set whichwrap+=<,>,h,l  " 光标行首行尾时自动换行
set list
set listchars=tab:▸\ ,trail:␣,extends:>,precedes:<,nbsp:+

set shiftwidth=4        " 设置制表符宽度"
set expandtab           " 用空格代替制表符
set tabstop=4           " 设置制表符宽度"
set softtabstop=4
set virtualedit=block

set nobomb
set fileencoding=utf-8 " 设置新文件的默认编码为 UTF-8
set encoding=utf-8 " 设置 Vim 内部的编码
set fileencodings=utf-8,gbk,gb2312,gb18030,cp936,ucs-bom,big5,latin1 " 设置读取文件时尝试的编码顺序

set completeopt+=popup
set autoindent          " 继承前一行的缩进方式，特别适用于多行注释
set number              " 设置行号
set hlsearch
set incsearch           " 在搜索时，输入的词句的逐字符高亮（类似firefox的搜索）

set cc=100
set ignorecase smartcase
set showmatch           " 显示匹配的括号
set autoread
set autowrite
set nowrap
set cursorline

set foldenable " 1. 启用折叠功能
set foldmethod=syntax   " 或者 indent / marker / expr
set foldlevelstart=99 " 3. 关键：文件打开时，所有折叠都展开
set foldnestmax=5 " 4. 限制最大嵌套层数，防止性能问题
set foldcolumn=2 " 5. （可选）在左侧显示折叠标识列

if !isdirectory(expand("~/.vimcache/"))
    call mkdir($HOME . "/.vimcache", "p")
endif

let g:netrw_liststyle = 3
let g:netrw_home =$HOME.'/.vimcache/'

set nobackup            "允许生成备份文件"
set nowritebackup
set noswapfile          "允许生成swap文件"
set undofile          "使得即使在文件关闭后也可以维护撤消历史记录
set undodir=~/.vimcache

set laststatus=2        " 显示状态栏
set statusline=
set statusline+=%#ErrorMsg#\ [%{toupper(mode())}]\
set statusline+=%#DiffAdd#\ %F
set statusline+=\ %#MoreMsg#\%m%r%w
set statusline+=%#StatuslineNC#
set statusline+=%=
set statusline+=%#DiffAdd#
set statusline+=\ %Y\ \|
set statusline+=\ %{&fileencoding}\ \|
set statusline+=\ %{&fileformat}\ \|
set statusline+=\ %{(&bomb?\",BOM\":\"NOBOM\")}\ \|
set statusline+=\ %l/%L,%c\ (%p%%)

if executable('rg')
  set grepprg=rg\ --vimgrep\ --no-heading\ --smart-case
  set grepformat=%f:%l:%c:%m
endif

nnoremap <F5> :silent make\|redraw!\|cc<CR>
nnoremap <F6> :cnext<CR>
nnoremap <F7> :cprevious<CR>
nnoremap <F8> :cclose<CR>

colorscheme desert

if empty(glob($HOME."/.vim/autoload/plug.vim"))
    command! InsPlug :! curl -fLo ~/.vim/autoload/plug.vim --create-dirs https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim
    finish
endif

call plug#begin()
""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
Plug 'dstein64/vim-startuptime'
Plug 'mhinz/vim-startify'
""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
Plug 'neoclide/coc.nvim', {'branch': 'release','for':['cpp', 'c','python']}
let g:coc_global_extensions = [
    \ 'coc-clangd',
    \ 'coc-pyright',
    \ 'coc-snippets','coc-highlight'
    \ ]
" \ 'coc-git',

nmap <silent> gd <Plug>(coc-definition)
nmap <silent> gy <Plug>(coc-type-definition)
nmap <silent> gi <Plug>(coc-implementation)
nmap <silent> gr <Plug>(coc-references)
" 代码编辑
"nmap <leader>f <Plug>(coc-format)
nmap <leader>ff <Plug>(coc-format-selected)
nmap <leader>rn <Plug>(coc-rename)    " 重命名符号

" 诊断和错误处理
nmap <silent> [g <Plug>(coc-diagnostic-prev) " 上一个错误
nmap <silent> ]g <Plug>(coc-diagnostic-next) " 下一个错误

if $MSYSTEM != ''
    let $COC_CONFIG_HOME = expand('/c/msys64//home/'.$USERNAME.'/.vim')
    let g:coc_config_home = $COC_CONFIG_HOME
    let g:coc_data_home = $COC_CONFIG_HOME
endif

let g:coc_diagnostic_virtual_text = 1
let g:coc_enable_virtual_text = 1

""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
Plug 'godlygeek/tabular'
""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
Plug 'junegunn/fzf', { 'do': { -> fzf#install() } }
Plug 'junegunn/fzf.vim'

" 设置触发快捷键
nmap <Leader>f :Files<CR>
nmap <Leader>b :Buffers<CR>
nmap <Leader>h :History<CR>
nmap <Leader>l :Lines<CR>

" 设置 fzf 使用 ripgrep 进行内容搜索
if executable('rg')
    set grepprg=rg\ --vimgrep\ --no-heading\ --smart-case
    let $FZF_DEFAULT_COMMAND = 'rg --files --hidden --follow --glob "!.git/*"'
endif

" 界面设置：使用弹出窗口（需要较新版本的 Vim 或 Neovim）
let g:fzf_layout = { 'window': { 'width': 0.9, 'height': 0.6 } }

""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
Plug 'preservim/vim-markdown',{'for':['markdown']}
let g:vim_markdown_math = 1
let g:vim_markdown_folding_level = 6
let g:vim_markdown_frontmatter = 1
let g:tex_conceal = ""
let g:vim_markdown_conceal = 0

""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
Plug 'airblade/vim-gitgutter'
Plug 'tpope/vim-surround'
Plug 'sheerun/vim-polyglot'
"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
Plug 'Yggdroot/LeaderF', { 'do': ':LeaderfInstallCExtension' }
let g:Lf_ShortcutF = "<leader>ff"
let g:Lf_Gtagsconf=expand('~/.gtags.conf')
let g:Lf_WorkingDirectoryMode = 'AF'
let g:Lf_RootMarkers = ['.project', '.git']
let g:Lf_WindowPosition = 'popup'
let g:Lf_PreviewInPopup = 1
let g:Lf_PreviewResult = {'Function': 0, 'BufTag': 0 }
let g:Lf_ShowDevIcons = 0
let g:Lf_WildIgnore={ 'file':['*.lib', '*.a', '*.o', '*.d', '*.so', ],'dir':['tmp', '.git', 'api', 'attachments', 'images', 'img', 'download',  ]}

noremap <silent> <leader>fb :Leaderf buffer <CR>
noremap <silent> <leader>fm :Leaderf mru    <CR>
noremap <silent> <leader>ft :Leaderf bufTag <CR>
noremap <silent> <leader>fl :Leaderf line   <CR>

let g:Lf_GtagsAutoGenerate = 1
let g:Lf_Gtagslabel = 'native-pygments'
noremap <leader>fr :<C-U><C-R>=printf("Leaderf! gtags -r %s --auto-jump", expand("<cword>"))<CR><CR>
noremap <leader>fd :<C-U><C-R>=printf("Leaderf! gtags -d %s --auto-jump", expand("<cword>"))<CR><CR>
noremap <leader>fo :<C-U><C-R>=printf("Leaderf! gtags --recall %s", "")<CR><CR>
noremap <leader>fn :<C-U><C-R>=printf("Leaderf  gtags --next %s", "")<CR><CR>
noremap <leader>fp :<C-U><C-R>=printf("Leaderf  gtags --previous %s", "")<CR><CR>

let g:Lf_CursorBlink =1 
let g:Lf_DefaultExternalTool = 'rg'
nmap <unique> <leader>fr0 <Plug>LeaderfRgPrompt
nmap <unique> <leader>fra <Plug>LeaderfRgCwordLiteralNoBoundary
nmap <unique> <leader>frb <Plug>LeaderfRgCwordLiteralBoundary
nmap <unique> <leader>frc <Plug>LeaderfRgCwordRegexNoBoundary
nmap <unique> <leader>frd <Plug>LeaderfRgCwordRegexBoundary
vmap <unique> <leader>fra <Plug>LeaderfRgVisualLiteralNoBoundary
vmap <unique> <leader>frb <Plug>LeaderfRgVisualLiteralBoundary
vmap <unique> <leader>frc <Plug>LeaderfRgVisualRegexNoBoundary
vmap <unique> <leader>frd <Plug>LeaderfRgVisualRegexBoundary
"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
Plug 'itchyny/lightline.vim'

let g:lightline = {
            \ 'component_function': {
            \   'git_hunks': 'lightline#hunks#composer', 
            \ },
            \ 'active': {
            \   'left': [
            \       [ 'mode', 'paste' ],
            \       [ 'git_hunks' ],                     
            \       [ 'readonly', 'filename', 'modified' ]
            \   ]
            \ }
            \ }

set laststatus=2 "显示状态栏
set noshowmode " 状态栏下面不在单独显示模式

""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
